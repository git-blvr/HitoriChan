# Discord bot (required)
TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here

# AI features (required for AI commands)
GROQ_API=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional
# GUILD_ID=test_guild_id_for_instant_command_updates
# DB_PATH=data/hitorichan.db
# SKIP_AUTO_DEPLOY=true

# Dashboard
# WEB_PORT=3000
# WEB_HOST=0.0.0.0
# PUBLIC_URL=https://hitori.example.com
# DASHBOARD_PASSWORD=persistent_admin_password  # otherwise generated each boot and printed to console
# DASHBOARD_ORIGINS=https://extra-origin.example.com  # extra allowed Origin for API mutations

# Discord OAuth sign-in (dashboard). Requires the application's client secret
# and a registered redirect URI of <dashboard-url>/auth/discord/callback.
# DISCORD_CLIENT_SECRET=your_oauth2_client_secret
# OAUTH_REDIRECT_URI=https://hitori.example.com/auth/discord/callback  # defaults to PUBLIC_URL + path
# DEV_USER_IDS=1017830522677891163  # comma-separated Discord IDs that get all guilds
# MAIN_GUILD_ID=1376236720030486670  # preselected server for developers

# HTTPS (optional — serve the dashboard over TLS)
# TLS_KEY_PATH=certs/privkey.pem
# TLS_CERT_PATH=certs/fullchain.pem
